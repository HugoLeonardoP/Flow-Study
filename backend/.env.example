# Configuração OPCIONAL do backend (a Wikipédia não exige chave de API).
# Copie para ".env" e use:  npm run start:env   (Node 20.6+)
# Nunca coloque senhas ou tokens aqui para versionar: o ".env" já está no .gitignore.

PORT=3000

# Idioma da Wikipédia consultada (pt, en, es...)
WIKIPEDIA_LANG=pt

# A Wikimedia pede um User-Agent que identifique o app. Inclua um contato SEU:
WIKIPEDIA_USER_AGENT=FlowStudy/1.0 (projeto academico; contato: seu-email@exemplo.com)

# Tempo máximo (ms) de cada chamada à Wikipédia
WIKIPEDIA_TIMEOUT_MS=4000
